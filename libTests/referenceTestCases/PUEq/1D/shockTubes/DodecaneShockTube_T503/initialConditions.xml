<?xml version = "1.0" encoding = "UTF-8" standalone = "yes"?>
<CI>
	<!-- LIST OF GEOMETRICAL DOMAINS  -->
	<physicalDomains>
		<domain name="base" state="lowPressure" type="entireDomain"/>
		<domain name="HP"  state="HighPressure" type="halfSpace">
            <dataHalfSpace axis="x" origin="0.200" direction="negative"/>
        </domain>
	</physicalDomains>

	<!-- LIST OF BOUNDARY CONDITIONS -->
	<boundaryConditions>
        <boundCond name="CLXm" type="nonReflecting" number="1"/>
        <boundCond name="CLXp" type="nonReflecting" number="2"/>
	</boundaryConditions>


	<!--  LIST OF STATES  -->
	<state name="lowPressure">
		<material type="fluid" EOS="IG_dodVap_papier2008.xml">
			<dataFluid alpha="1" density="1.e-4"/>
		</material>
		<material type="fluid" EOS="SG_dodLiq_papier2008.xml">
			<dataFluid alpha="0" temperature="573."/>
		</material>
		<mixture>
			<dataMix pressure = "1.e2"/>
            <velocity x="0." y="0." z="0."/>
        </mixture>
	</state>
	<state name="HighPressure">
		<material type="fluid" EOS="IG_dodVap_papier2008.xml">
			<dataFluid alpha="0" temperature="573."/>
		</material>
		<material type="fluid" EOS="SG_dodLiq_papier2008.xml">
			<dataFluid alpha="1" temperature="573."/>
		</material>
		<mixture>
			<dataMix pressure = "13e5"/>
            <velocity x="0." y="0." z="0."/>
        </mixture>
	</state>
</CI>
